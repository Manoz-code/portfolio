:root {
  --background: #050505;
  --surface: #0c0c0c;
  --border: #222;
  --muted: #777;
  --text-muted: #999;
  --white: #fff;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--background);
  color: var(--white);
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

body,
a,
button {
  cursor: default;
}

a {
  color: inherit;
  text-decoration: none;
}

a,
button {
  -webkit-tap-highlight-color: transparent;
}

button {
  font: inherit;
}

.app {
  min-height: 100vh;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 70% 10%,
      rgba(255, 255, 255, 0.025),
      transparent 25%
    ),
    #050505;
}

/* =========================================================
   NAVIGATION
========================================================= */

.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;

  height: 82px;
  padding: 0 5vw;

  display: flex;
  align-items: center;
  justify-content: space-between;

  z-index: 100;

  background: rgba(5, 5, 5, 0.48);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  border-bottom: 1px solid rgba(255, 255, 255, 0.025);
}

.logo {
  font-size: 18px;
  font-weight: 800;
  letter-spacing: 0.18em;
}

.navbar nav {
  display: flex;
  gap: 30px;
}

.navbar nav a {
  color: var(--muted);
  font-size: 13px;

  transition:
    color 0.3s ease,
    transform 0.3s ease;
}

.navbar nav a:hover {
  color: white;
  transform: translateY(-1px);
}

.nav-button {
  padding: 10px 17px;

  border: 1px solid var(--border);
  border-radius: 999px;

  color: #ddd;
  font-size: 13px;

  transition:
    border-color 0.3s ease,
    transform 0.3s ease,
    background 0.3s ease;
}

.nav-button:hover {
  border-color: #555;
  background: #111;
  transform: translateY(-2px);
}

/* =========================================================
   HERO
========================================================= */

.hero {
  position: relative;

  min-height: 100vh;
  width: min(1400px, 90%);

  margin: auto;

  display: grid;
  grid-template-columns: 0.95fr 1.05fr;

  align-items: center;

  gap: 40px;
}

.hero-content {
  position: relative;
  z-index: 5;
}

.eyebrow,
.section-label {
  color: var(--muted);

  font-size: 11px;
  font-weight: 600;

  letter-spacing: 0.2em;
}

.hero h1 {
  margin: 20px 0 0;

  max-width: 750px;

  font-size: clamp(60px, 8vw, 120px);

  line-height: 0.9;

  letter-spacing: -0.065em;
}

.hero h1 span {
  display: block;
  color: #666;
}

.hero-description {
  max-width: 510px;

  margin: 35px 0 0;

  color: var(--text-muted);

  font-size: 17px;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;

  margin-top: 35px;
}

.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  gap: 14px;

  padding: 15px 22px;

  border-radius: 999px;

  font-size: 14px;

  transition:
    transform 0.3s ease,
    background 0.3s ease,
    border-color 0.3s ease;
}

.primary-button {
  background: white;
  color: black;
}

.secondary-button {
  border: 1px solid var(--border);
  color: white;
}

.primary-button:hover,
.secondary-button:hover {
  transform: translateY(-4px);
}

.primary-button span {
  font-size: 18px;
}

/* =========================================================
   THREE.JS
========================================================= */

.hero-visual {
  position: relative;

  width: 100%;
  height: min(760px, 88vh);

  min-height: 500px;

  overflow: hidden;

  border-radius: 40px;

  background:
    radial-gradient(
      circle at 50% 45%,
      rgba(255, 255, 255, 0.035),
      transparent 48%
    ),
    #050505;

  border: 1px solid rgba(255, 255, 255, 0.06);
}

.three-experience {
  position: absolute;
  inset: 0;

  z-index: 1;
}

.three-experience canvas {
  display: block;
  width: 100% !important;
  height: 100% !important;
}

.scene-overlay {
  position: absolute;
  inset: 0;

  pointer-events: none;

  z-index: 3;
}

.scene-status {
  position: absolute;

  top: 25px;
  right: 25px;

  display: flex;
  align-items: center;
  gap: 8px;

  padding: 9px 12px;

  border: 1px solid #242424;
  border-radius: 999px;

  background: rgba(0, 0, 0, 0.35);

  color: #777;

  font-size: 9px;
  letter-spacing: 0.14em;
}

.status-dot {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #aaa;

  box-shadow: 0 0 12px rgba(255, 255, 255, 0.7);
}

.scene-caption {
  position: absolute;

  bottom: 25px;
  left: 25px;

  display: flex;
  align-items: center;
  gap: 15px;
}

.scene-caption span {
  color: #555;

  font-family: monospace;
  font-size: 12px;
}

.scene-caption p {
  margin: 0;

  color: #555;

  font-size: 9px;
  letter-spacing: 0.2em;
}

/* =========================================================
   GENERAL SECTIONS
========================================================= */

.section {
  width: min(1200px, 88%);

  min-height: 100vh;

  margin: auto;

  padding: 140px 0;

  display: grid;
  grid-template-columns: 180px 1fr;

  gap: 60px;

  align-items: center;
}

.section-content h2 {
  margin: 0;

  font-size: clamp(50px, 7vw, 100px);

  line-height: 0.95;

  letter-spacing: -0.06em;
}

.section-content h2 span {
  color: #555;
}

.section-content > p {
  max-width: 600px;

  margin-top: 35px;

  color: #999;

  font-size: 18px;

  line-height: 1.7;
}

/* =========================================================
   SKILLS
========================================================= */

.skills {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 12px;

  margin-top: 70px;
}

.skills div {
  padding: 28px;

  border: 1px solid var(--border);

  border-radius: 18px;

  color: #aaa;

  transition:
    transform 0.3s ease,
    border-color 0.3s ease,
    background 0.3s ease;
}

.skills div:hover {
  transform: translateY(-6px);

  border-color: #555;

  background: #0a0a0a;
}

/* =========================================================
   PROJECTS
========================================================= */

.projects-section {
  align-items: start;
}

.projects-section .section-content {
  width: 100%;
}

.projects-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 50px;
}

.projects-intro {
  max-width: 330px;

  margin: 0 0 10px;

  color: #666;

  font-size: 14px;
  line-height: 1.7;
}

/* GRID */

.projects-grid {
  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 20px;

  margin-top: 80px;
}

/* CARD */

.project-card {
  position: relative;

  overflow: hidden;

  min-height: 600px;

  display: flex;
  flex-direction: column;

  border: 1px solid rgba(255, 255, 255, 0.08);

  border-radius: 28px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.045),
      rgba(255, 255, 255, 0.012)
    ),
    #080808;

  transition:
    transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
    border-color 0.45s ease,
    box-shadow 0.45s ease;
}

.project-card::before {
  content: "";

  position: absolute;

  inset: 0;

  pointer-events: none;

  background:
    linear-gradient(
      135deg,
      transparent 20%,
      rgba(255, 255, 255, 0.025) 50%,
      transparent 80%
    );

  opacity: 0;

  transition: opacity 0.45s ease;
}

.project-card:hover {
  transform: translateY(-10px);

  border-color: color-mix(
    in srgb,
    var(--project-color) 50%,
    #222
  );

  box-shadow:
    0 30px 80px rgba(0, 0, 0, 0.4),
    0 0 45px
      color-mix(
        in srgb,
        var(--project-color) 10%,
        transparent
      );
}

.project-card:hover::before {
  opacity: 1;
}

/* CARD TOP */

.project-card-top {
  position: relative;
  z-index: 2;

  padding: 25px 28px;

  display: flex;
  justify-content: space-between;

  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.project-number {
  color: #555;

  font-family: monospace;
  font-size: 11px;
}

.project-year {
  color: #555;

  font-family: monospace;
  font-size: 11px;
}

/* PROJECT VISUAL */

.project-visual {
  position: relative;

  height: 260px;

  overflow: hidden;

  display: flex;
  align-items: center;
  justify-content: center;

  border-bottom: 1px solid rgba(255, 255, 255, 0.06);

  background:
    radial-gradient(
      circle at center,
      color-mix(
        in srgb,
        var(--project-color) 12%,
        transparent
      ),
      transparent 60%
    ),
    #050505;
}

.project-glow {
  position: absolute;

  width: 180px;
  height: 180px;

  border-radius: 50%;

  background: var(--project-color);

  opacity: 0.05;

  filter: blur(55px);

  transition:
    opacity 0.45s ease,
    transform 0.45s ease;
}

.project-card:hover .project-glow {
  opacity: 0.13;

  transform: scale(1.4);
}

/* STATUS */

.project-status {
  position: absolute;

  top: 18px;
  right: 20px;

  display: flex;
  align-items: center;
  gap: 7px;

  padding: 7px 10px;

  border: 1px solid rgba(255, 255, 255, 0.08);

  border-radius: 999px;

  background: rgba(0, 0, 0, 0.4);

  color: #666;

  font-family: monospace;

  font-size: 8px;

  letter-spacing: 0.08em;
}

.project-status span {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: #00ff88;

  box-shadow: 0 0 10px #00ff88;
}

/* =========================================================
   RIDE VISUAL
========================================================= */

.ride-visual {
  position: relative;

  width: 250px;
  height: 150px;
}

.ride-road {
  position: absolute;

  left: 10px;
  right: 10px;

  bottom: 20px;

  height: 2px;

  background: var(--project-color);

  opacity: 0.25;

  box-shadow:
    0 0 18px var(--project-color),
    0 0 40px var(--project-color);
}

.ride-car {
  position: absolute;

  left: 50%;
  bottom: 48px;

  width: 110px;
  height: 42px;

  transform: translateX(-50%);

  border: 1px solid
    color-mix(
      in srgb,
      var(--project-color) 55%,
      #222
    );

  border-radius: 16px 20px 8px 8px;

  background: linear-gradient(
    145deg,
    #191919,
    #070707
  );

  box-shadow:
    0 15px 30px rgba(0, 0, 0, 0.5),
    0 0 25px
      color-mix(
        in srgb,
        var(--project-color) 15%,
        transparent
      );

  transition: transform 0.45s ease;
}

.project-card:hover .ride-car {
  transform:
    translateX(-50%)
    translateY(-8px);
}

.ride-window {
  position: absolute;

  left: 30px;
  top: -15px;

  width: 50px;
  height: 22px;

  border: 1px solid #333;

  border-bottom: 0;

  border-radius: 12px 14px 0 0;

  background: #0c1517;

  transform: skewX(-12deg);
}

.ride-wheel {
  position: absolute;

  bottom: -8px;

  width: 17px;
  height: 17px;

  border: 3px solid #333;

  border-radius: 50%;

  background: #050505;

  box-shadow: 0 0 10px rgba(0, 0, 0, 0.8);
}

.wheel-left {
  left: 17px;
}

.wheel-right {
  right: 17px;
}

.ride-route {
  position: absolute;

  left: 20px;
  right: 20px;

  bottom: 5px;

  display: flex;
  justify-content: space-between;
}

.ride-route span {
  width: 4px;
  height: 4px;

  border-radius: 50%;

  background: var(--project-color);

  box-shadow: 0 0 8px var(--project-color);
}

/* =========================================================
   WATER VISUAL
========================================================= */

.water-visual {
  position: relative;

  width: 180px;
  height: 180px;
}

.water-core {
  position: absolute;

  left: 50%;
  top: 50%;

  width: 92px;
  height: 92px;

  transform: translate(-50%, -50%);

  border: 1px solid
    color-mix(
      in srgb,
      var(--project-color) 70%,
      #222
    );

  border-radius: 50%;

  background:
    radial-gradient(
      circle at 35% 30%,
      rgba(255, 255, 255, 0.35),
      transparent 18%
    ),
    radial-gradient(
      circle,
      color-mix(
        in srgb,
        var(--project-color) 45%,
        #050505
      ),
      #050505
    );

  box-shadow:
    inset 0 0 25px
      color-mix(
        in srgb,
        var(--project-color) 30%,
        transparent
      ),
    0 0 35px
      color-mix(
        in srgb,
        var(--project-color) 20%,
        transparent
      );

  transition:
    transform 0.5s ease,
    box-shadow 0.5s ease;
}

.project-card:hover .water-core {
  transform:
    translate(-50%, -50%)
    scale(1.12);

  box-shadow:
    inset 0 0 30px
      color-mix(
        in srgb,
        var(--project-color) 45%,
        transparent
      ),
    0 0 55px
      color-mix(
        in srgb,
        var(--project-color) 30%,
        transparent
      );
}

.water-ring {
  position: absolute;

  left: 50%;
  top: 50%;

  width: 140px;
  height: 140px;

  transform: translate(-50%, -50%);

  border: 1px solid
    color-mix(
      in srgb,
      var(--project-color) 25%,
      transparent
    );

  border-radius: 50%;

  animation: waterPulse 4s ease-in-out infinite;
}

.water-drop {
  position: absolute;

  color: var(--project-color);

  font-size: 12px;

  opacity: 0.7;

  animation: waterFloat 3s ease-in-out infinite;
}

.drop-one {
  top: 25px;
  left: 20px;
}

.drop-two {
  top: 60px;
  right: 12px;

  animation-delay: 0.8s;
}

.drop-three {
  bottom: 18px;
  left: 35px;

  animation-delay: 1.4s;
}

@keyframes waterPulse {
  0%,
  100% {
    transform: translate(-50%, -50%) scale(0.95);

    opacity: 0.35;
  }

  50% {
    transform: translate(-50%, -50%) scale(1.08);

    opacity: 0.7;
  }
}

@keyframes waterFloat {
  0%,
  100% {
    transform: translateY(4px);

    opacity: 0.35;
  }

  50% {
    transform: translateY(-8px);

    opacity: 0.9;
  }
}

/* =========================================================
   PROJECT CONTENT
========================================================= */

.project-card-content {
  position: relative;
  z-index: 2;

  flex: 1;

  padding: 28px;
}

.project-category {
  margin-bottom: 12px;

  color: var(--project-color);

  font-family: monospace;

  font-size: 9px;

  letter-spacing: 0.15em;

  text-transform: uppercase;
}

.project-card-content h3 {
  margin: 0;

  font-size: clamp(28px, 3vw, 42px);

  line-height: 1;

  letter-spacing: -0.045em;
}

.project-card-content p {
  max-width: 450px;

  margin: 18px 0 0;

  color: #777;

  font-size: 14px;

  line-height: 1.7;
}

.project-tech {
  display: flex;

  flex-wrap: wrap;

  gap: 7px;

  margin-top: 24px;
}

.project-tech span {
  padding: 7px 9px;

  border: 1px solid rgba(255, 255, 255, 0.07);

  border-radius: 999px;

  color: #777;

  font-family: monospace;

  font-size: 9px;

  transition:
    color 0.3s ease,
    border-color 0.3s ease,
    background 0.3s ease;
}

.project-card:hover .project-tech span {
  border-color:
    color-mix(
      in srgb,
      var(--project-color) 20%,
      #222
    );

  color: #aaa;
}

/* =========================================================
   PROJECT FOOTER
========================================================= */

.project-card-footer {
  position: relative;
  z-index: 2;

  padding: 20px 28px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.project-card-footer > span {
  color: #444;

  font-family: monospace;

  font-size: 9px;

  letter-spacing: 0.12em;
}

.project-card-footer button {
  border: 0;

  padding: 0;

  display: inline-flex;
  align-items: center;
  gap: 10px;

  background: transparent;

  color: #aaa;

  font-size: 12px;

  transition:
    color 0.3s ease,
    transform 0.3s ease;
}

.project-card-footer button:hover {
  color: white;

  transform: translateX(4px);
}

.project-card-footer button b {
  font-size: 16px;

  font-weight: 400;

  color: var(--project-color);
}

/* PROJECT ACTIVE */

.project-active {
  transform: translateY(-6px) scale(1.02);

  border-color: #00e5ff !important;

  box-shadow:
    0 0 0 1px rgba(0, 229, 255, 0.3),
    0 0 35px rgba(0, 229, 255, 0.18);
}

/* PROJECTS FOOTER */

.projects-footer {
  margin-top: 25px;

  display: grid;

  grid-template-columns: auto 1fr auto;

  align-items: center;

  gap: 15px;

  color: #444;

  font-family: monospace;

  font-size: 8px;

  letter-spacing: 0.12em;
}

.projects-footer div {
  height: 1px;

  background: #1b1b1b;
}

/* =========================================================
   JOURNEY
========================================================= */

.journey {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 20px;

  margin-top: 70px;
}

.journey > div {
  padding: 30px;

  border-top: 1px solid #333;
}

.journey small {
  color: #555;
}

.journey h3 {
  margin: 35px 0 10px;

  font-size: 28px;
}

.journey p {
  margin: 0;

  color: #777;
}

/* =========================================================
   CONTACT
========================================================= */

.contact {
  min-height: 90vh;

  width: min(1200px, 88%);

  margin: auto;

  display: flex;
  flex-direction: column;

  justify-content: center;
}

.contact h2 {
  margin: 25px 0 45px;

  font-size: clamp(60px, 9vw, 130px);

  line-height: 0.9;

  letter-spacing: -0.07em;
}

.contact h2 span {
  display: block;

  color: #555;
}

.contact .primary-button {
  width: fit-content;
}

/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1000px) {
  .hero {
    grid-template-columns: 1fr;

    padding-top: 110px;
  }

  .hero-content {
    max-width: 760px;
  }

  .hero-visual {
    height: 600px;
  }

  .section {
    grid-template-columns: 1fr;

    gap: 35px;
  }

  .projects-heading {
    align-items: flex-start;

    flex-direction: column;

    gap: 25px;
  }

  .projects-intro {
    margin: 0;
  }

  .projects-grid {
    grid-template-columns: 1fr;

    margin-top: 60px;
  }
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {
  .navbar {
    height: 68px;

    padding: 0 6vw;
  }

  .navbar nav,
  .nav-button {
    display: none;
  }

  .hero {
    width: 90%;

    padding-top: 105px;

    gap: 35px;
  }

  .hero h1 {
    font-size: clamp(52px, 15vw, 85px);
  }

  .hero-description {
    font-size: 15px;

    line-height: 1.65;
  }

  .hero-actions {
    margin-top: 28px;
  }

  .primary-button,
  .secondary-button {
    padding: 14px 18px;
  }

  .hero-visual {
    height: 520px;

    min-height: 420px;

    border-radius: 28px;
  }

  .scene-status {
    top: 16px;
    right: 16px;
  }

  .scene-caption {
    bottom: 16px;
    left: 16px;
  }

  .section {
    width: 88%;

    padding: 110px 0;
  }

  .section-content h2 {
    font-size: clamp(48px, 13vw, 78px);
  }

  .section-content > p {
    font-size: 16px;
  }

  .skills,
  .journey {
    grid-template-columns: 1fr;

    margin-top: 50px;
  }

  .skills div {
    padding: 22px;
  }

  /* PROJECTS */

  .projects-section {
    padding-top: 100px;
  }

  .projects-grid {
    margin-top: 50px;

    gap: 16px;
  }

  .project-card {
    min-height: 560px;

    border-radius: 22px;
  }

  .project-card-top {
    padding: 20px;
  }

  .project-visual {
    height: 220px;
  }

  .project-card-content {
    padding: 24px 20px;
  }

  .project-card-content h3 {
    font-size: 32px;
  }

  .project-card-content p {
    font-size: 13px;
  }

  .project-card-footer {
    padding: 18px 20px;
  }

  .projects-footer {
    display: flex;

    justify-content: space-between;
  }

  .projects-footer div {
    display: none;
  }

  .journey {
    gap: 35px;
  }

  .journey h3 {
    margin-top: 22px;
  }

  .contact {
    width: 88%;

    min-height: 80vh;
  }

  .contact h2 {
    font-size: clamp(55px, 15vw, 90px);
  }
}

/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 400px) {
  .hero-visual {
    height: 450px;
  }

  .hero-actions {
    flex-direction: column;

    align-items: flex-start;
  }

  .primary-button,
  .secondary-button {
    width: auto;
  }

  .project-card {
    min-height: 540px;
  }

  .project-visual {
    height: 200px;
  }

  .project-card-content h3 {
    font-size: 28px;
  }

  .project-tech span {
    font-size: 8px;
  }
}

/* =========================================================
   ACCESSIBILITY
========================================================= */

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;

    animation-iteration-count: 1 !important;

    transition-duration: 0.01ms !important;
  }
}
/* =========================================
   ADVANCED PORTFOLIO ANIMATIONS
========================================= */

html {
  scroll-behavior: smooth;
}

.navbar {
  transition:
    background 0.35s ease,
    backdrop-filter 0.35s ease,
    border-color 0.35s ease,
    transform 0.35s ease;
}

.navbar-scrolled {
  background: rgba(3, 3, 3, 0.72);
  backdrop-filter: blur(18px);
  border-bottom-color: rgba(255, 255, 255, 0.08);
}

.reveal {
  opacity: 0;
  transform: translateY(45px);
  transition:
    opacity 0.8s ease,
    transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
}

.reveal-visible {
  opacity: 1;
  transform: translateY(0);
}

.project-card {
  transition:
    transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
    border-color 0.35s ease,
    box-shadow 0.35s ease;
}

.project-card:hover {
  transform: translateY(-10px);
}

.project-card.project-active {
  animation: projectPulse 1.8s ease;
}

@keyframes projectPulse {
  0% {
    transform: scale(1);
  }

  25% {
    transform: scale(1.025);
  }

  50% {
    transform: scale(1);
  }

  75% {
    transform: scale(1.015);
  }

  100% {
    transform: scale(1);
  }
}

.project-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 70% 15%,
      color-mix(
        in srgb,
        var(--project-color) 12%,
        transparent
      ),
      transparent 35%
    ),
    #030303;
}

.project-page-nav {
  width: min(1400px, calc(100% - 48px));
  margin: 0 auto;
  min-height: 90px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 2;
}

.back-link {
  color: #888;
  text-decoration: none;
  transition: color 0.25s ease;
}

.back-link:hover {
  color: #fff;
}

.project-hero {
  width: min(1100px, calc(100% - 48px));
  margin: 0 auto;
  padding: 120px 0 160px;
}

.project-page-meta {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  margin-bottom: 55px;
}

.project-page-meta span {
  padding: 8px 12px;
  border: 1px solid rgba(255,255,255,0.1);
  color: #888;
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.project-hero h1 {
  max-width: 950px;
  font-size: clamp(4rem, 9vw, 9rem);
  line-height: 0.9;
  letter-spacing: -0.06em;
  margin: 20px 0 35px;
}

.project-hero h1 span {
  display: block;
  color: var(--project-color);
}

.project-page-description {
  max-width: 650px;
  color: #999;
  font-size: 18px;
  line-height: 1.8;
}

.project-page-actions {
  display: flex;
  gap: 14px;
  margin-top: 40px;
  flex-wrap: wrap;
}

.project-case-study {
  width: min(1100px, calc(100% - 48px));
  margin: 0 auto;
  border-top: 1px solid rgba(255,255,255,0.08);
}

.case-study-block {
  display: grid;
  grid-template-columns: 100px 1fr;
  gap: 50px;
  padding: 90px 0;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}

.case-study-number {
  color: var(--project-color);
  font-family: monospace;
  font-size: 13px;
}

.case-study-label {
  color: #666;
  font-size: 11px;
  letter-spacing: 0.15em;
  margin-bottom: 25px;
}

.case-study-block h2 {
  max-width: 700px;
  font-size: clamp(2.5rem, 5vw, 5rem);
  line-height: 1;
  letter-spacing: -0.05em;
  margin: 0 0 30px;
}

.case-study-block h2 span {
  display: block;
  color: var(--project-color);
}

.case-study-block p {
  max-width: 650px;
  color: #888;
  line-height: 1.8;
}

.case-study-tech {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.case-study-tech span {
  padding: 12px 16px;
  border: 1px solid rgba(255,255,255,0.1);
  color: #aaa;
  font-size: 13px;
}

.project-page-footer {
  width: min(1100px, calc(100% - 48px));
  margin: 0 auto;
  padding: 100px 0;
}

.project-not-found {
  padding: 15vw 8vw;
}

.project-not-found h1 {
  font-size: clamp(3rem, 8vw, 7rem);
  line-height: 0.95;
}

.project-not-found h1 span {
  display: block;
  color: #00e5ff;
}

/* Mobile */

@media (max-width: 768px) {
  .project-page-nav {
    width: min(100% - 28px, 1400px);
    min-height: 72px;
  }

  .project-hero {
    width: min(100% - 28px, 1100px);
    padding: 80px 0 100px;
  }

  .project-hero h1 {
    font-size: clamp(3.5rem, 16vw, 6rem);
  }

  .project-page-description {
    font-size: 16px;
  }

  .project-case-study {
    width: min(100% - 28px, 1100px);
  }

  .case-study-block {
    grid-template-columns: 1fr;
    gap: 25px;
    padding: 65px 0;
  }

  .case-study-block h2 {
    font-size: clamp(2.5rem, 12vw, 4rem);
  }
}

@media (max-width: 520px) {
  .project-page-nav .back-link {
    font-size: 12px;
  }

  .project-page-meta {
    gap: 7px;
  }

  .project-page-meta span {
    font-size: 9px;
  }

  .project-page-actions {
    flex-direction: column;
    align-items: stretch;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }

  .reveal {
    opacity: 1;
    transform: none;
  }
}

/* ================================
   3D SCENE LOADER
================================ */

.scene-loader {
  position: fixed;
  inset: 0;
  z-index: 9999;

  display: grid;
  place-items: center;

  background:
    radial-gradient(
      circle at center,
      rgba(0, 229, 255, 0.055),
      transparent 35%
    ),
    #030303;

  transition:
    opacity 0.8s ease,
    visibility 0.8s ease;
}

.scene-loader-complete {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.loader-content {
  width: min(360px, calc(100% - 48px));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loader-brand {
  margin-bottom: 55px;

  color: #fff;

  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.35em;
}

.loader-object {
  position: relative;

  width: 150px;
  height: 150px;

  display: grid;
  place-items: center;

  perspective: 700px;
}

.loader-ring {
  position: absolute;

  width: 100%;
  height: 100%;

  border: 1px solid rgba(0, 229, 255, 0.25);
  border-radius: 50%;

  transform-style: preserve-3d;
}

.ring-one {
  animation: loaderSpinOne 5s linear infinite;
}

.ring-two {
  width: 78%;
  height: 78%;

  border-color: rgba(255, 255, 255, 0.18);

  animation: loaderSpinTwo 3.5s linear infinite;
}

.ring-three {
  width: 55%;
  height: 55%;

  border-color: rgba(0, 229, 255, 0.5);

  animation: loaderSpinThree 2.5s linear infinite;
}

.loader-core {
  width: 32px;
  height: 32px;

  display: grid;
  place-items: center;

  border: 1px solid rgba(255, 255, 255, 0.5);

  transform: rotate(45deg);

  box-shadow:
    0 0 25px rgba(0, 229, 255, 0.35),
    inset 0 0 18px rgba(0, 229, 255, 0.15);

  animation: loaderCore 2s ease-in-out infinite;
}

.loader-core span {
  width: 8px;
  height: 8px;

  background: #00e5ff;

  box-shadow:
    0 0 12px #00e5ff,
    0 0 30px rgba(0, 229, 255, 0.7);
}

.loader-info {
  width: 100%;

  display: flex;
  justify-content: space-between;

  margin-top: 55px;

  color: #666;

  font-family: monospace;
  font-size: 10px;
  letter-spacing: 0.12em;
}

.loader-info span:first-child {
  color: #00e5ff;
}

.loader-progress {
  width: 100%;
  height: 1px;

  margin-top: 12px;

  background: rgba(255, 255, 255, 0.08);
}

.loader-progress div {
  height: 100%;

  background: #00e5ff;

  box-shadow:
    0 0 10px rgba(0, 229, 255, 0.8);

  transition: width 0.08s linear;
}

@keyframes loaderSpinOne {
  from {
    transform: rotateX(65deg) rotateZ(0deg);
  }

  to {
    transform: rotateX(65deg) rotateZ(360deg);
  }
}

@keyframes loaderSpinTwo {
  from {
    transform: rotateY(65deg) rotateZ(360deg);
  }

  to {
    transform: rotateY(65deg) rotateZ(0deg);
  }
}

@keyframes loaderSpinThree {
  from {
    transform: rotateX(65deg) rotateY(25deg) rotateZ(0deg);
  }

  to {
    transform: rotateX(65deg) rotateY(25deg) rotateZ(360deg);
  }
}

@keyframes loaderCore {
  0%,
  100% {
    transform: rotate(45deg) scale(1);
  }

  50% {
    transform: rotate(225deg) scale(1.15);
  }
}

@media (max-width: 520px) {
  .loader-object {
    width: 120px;
    height: 120px;
  }

  .loader-brand {
    margin-bottom: 40px;
  }

  .loader-info {
    margin-top: 40px;
    font-size: 9px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .loader-ring,
  .loader-core {
    animation: none;
  }
}

/* =========================================
   PROJECT CASE STUDY
========================================= */

.project-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background: #030303;
  color: #ffffff;
}

.project-page-glow {
  position: absolute;
  width: 700px;
  height: 700px;
  top: -250px;
  right: -180px;
  border-radius: 50%;
  background: var(--project-color);
  opacity: 0.08;
  filter: blur(100px);
  pointer-events: none;
}

.project-page-grid {
  position: absolute;
  inset: 0;
  opacity: 0.06;
  pointer-events: none;
  background-image:
    linear-gradient(
      rgba(255,255,255,0.08) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,0.08) 1px,
      transparent 1px
    );
  background-size: 80px 80px;
  mask-image: linear-gradient(
    to bottom,
    black,
    transparent 70%
  );
}

.project-page-nav {
  position: relative;
  z-index: 10;
  width: min(1200px, calc(100% - 48px));
  margin: 0 auto;
  padding: 32px 0;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-bottom: 1px solid
    rgba(255,255,255,0.08);
}

.project-page-nav .logo {
  color: #ffffff;
  text-decoration: none;
  font-weight: 800;
  letter-spacing: 0.2em;
}

.back-link {
  color: #777;
  text-decoration: none;
  font-size: 12px;
  letter-spacing: 0.08em;
  transition: color 0.3s ease;
}

.back-link:hover {
  color: #ffffff;
}

/* HERO */

.project-hero {
  position: relative;
  z-index: 2;

  width: min(1000px, calc(100% - 48px));
  margin: 0 auto;

  padding: 120px 0 80px;
}

.project-page-meta {
  display: flex;
  gap: 12px;
  margin-bottom: 45px;
}

.project-page-meta span {
  padding: 8px 12px;
  border: 1px solid
    rgba(255,255,255,0.1);

  color: #777;
  font-size: 9px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.project-hero h1 {
  margin: 18px 0 30px;

  max-width: 900px;

  font-size: clamp(58px, 9vw, 128px);
  line-height: 0.88;
  letter-spacing: -0.055em;
}

.project-hero h1 span {
  display: block;
  color: #777;
}

.project-page-description {
  max-width: 620px;

  color: #999;
  font-size: 18px;
  line-height: 1.7;
}

.project-page-actions {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-top: 38px;
}

.project-private {
  color: var(--project-color);
  font-family: monospace;
  font-size: 10px;
  letter-spacing: 0.12em;
}

/* VISUAL */

.case-study-visual {
  position: relative;

  width: min(1200px, calc(100% - 48px));
  height: 520px;

  margin: 40px auto 120px;

  border: 1px solid
    rgba(255,255,255,0.08);

  background:
    radial-gradient(
      circle at center,
      color-mix(
        in srgb,
        var(--project-color) 12%,
        transparent
      ),
      transparent 55%
    ),
    rgba(255,255,255,0.015);

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;
}

.case-study-core {
  width: 170px;
  height: 170px;

  border: 1px solid var(--project-color);
  border-radius: 50%;

  display: grid;
  place-items: center;

  color: #ffffff;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: 0.12em;

  box-shadow:
    0 0 30px
      color-mix(
        in srgb,
        var(--project-color) 35%,
        transparent
      ),
    inset 0 0 30px
      color-mix(
        in srgb,
        var(--project-color) 12%,
        transparent
      );

  animation: caseStudyCore 4s ease-in-out infinite;
}

.case-study-orbit {
  position: absolute;

  width: 400px;
  height: 160px;

  border: 1px solid
    color-mix(
      in srgb,
      var(--project-color) 35%,
      transparent
    );

  border-radius: 50%;
}

.orbit-one {
  transform: rotate(25deg);
  animation: orbitOne 10s linear infinite;
}

.orbit-two {
  width: 300px;
  height: 420px;

  transform: rotate(-30deg);
  animation: orbitTwo 14s linear infinite;
}

.case-study-floating {
  position: absolute;

  padding: 12px 18px;

  border: 1px solid
    color-mix(
      in srgb,
      var(--project-color) 45%,
      transparent
    );

  background: rgba(3,3,3,0.72);

  color: #aaa;

  font-family: monospace;
  font-size: 10px;
  letter-spacing: 0.08em;

  backdrop-filter: blur(10px);
}

.floating-one {
  top: 25%;
  left: 12%;
}

.floating-two {
  right: 12%;
  top: 32%;
}

.floating-three {
  bottom: 20%;
  left: 25%;
}

/* CONTENT */

.case-study-content {
  position: relative;
  z-index: 2;

  width: min(1000px, calc(100% - 48px));
  margin: 0 auto;
}

.case-study-block {
  display: grid;
  grid-template-columns: 90px 1fr;
  gap: 50px;

  padding: 100px 0;

  border-top: 1px solid
    rgba(255,255,255,0.08);
}

.case-study-number {
  color: var(--project-color);
  font-family: monospace;
  font-size: 11px;
  letter-spacing: 0.1em;
}

.case-study-copy {
  max-width: 720px;
}

.case-study-label {
  margin-bottom: 25px;

  color: #666;

  font-family: monospace;
  font-size: 10px;
  letter-spacing: 0.18em;
}

.case-study-copy h2 {
  margin: 0 0 30px;

  font-size: clamp(42px, 6vw, 76px);
  line-height: 0.95;
  letter-spacing: -0.045em;
}

.case-study-copy h2 span {
  display: block;
  color: #666;
}

.case-study-copy > p {
  max-width: 650px;

  color: #999;

  font-size: 17px;
  line-height: 1.8;
}

/* ARCHITECTURE */

.architecture-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1px;

  margin-top: 50px;

  background: rgba(255,255,255,0.08);
}

.architecture-item {
  min-height: 110px;

  padding: 24px;

  background: #030303;

  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.architecture-item span {
  color: var(--project-color);
  font-family: monospace;
  font-size: 10px;
}

.architecture-item strong {
  color: #aaa;
  font-size: 14px;
  font-weight: 500;
}

/* HIGHLIGHTS */

.highlight-list {
  margin-top: 40px;
}

.highlight-item {
  display: grid;
  grid-template-columns: 50px 1fr;
  gap: 20px;

  padding: 22px 0;

  border-bottom: 1px solid
    rgba(255,255,255,0.08);
}

.highlight-item span {
  color: var(--project-color);
  font-family: monospace;
  font-size: 10px;
}

.highlight-item p {
  margin: 0;
  color: #aaa;
}

/* TECHNOLOGY */

.case-study-tech {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;

  margin-top: 45px;
}

.case-study-tech span {
  padding: 12px 16px;

  border: 1px solid
    rgba(255,255,255,0.1);

  color: #aaa;

  font-family: monospace;
  font-size: 11px;

  transition:
    border-color 0.3s ease,
    color 0.3s ease,
    transform 0.3s ease;
}

.case-study-tech span:hover {
  color: var(--project-color);

  border-color:
    var(--project-color);

  transform: translateY(-3px);
}

/* STATUS */

.status-display {
  display: flex;
  align-items: center;
  gap: 14px;

  margin-top: 45px;

  padding: 22px;

  border: 1px solid
    rgba(255,255,255,0.08);

  color: #999;

  font-family: monospace;
  font-size: 11px;
  letter-spacing: 0.08em;
}

.status-display > span:last-child {
  margin-left: auto;
  color: #555;
}

.status-dot {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: var(--project-color);

  box-shadow:
    0 0 12px var(--project-color);

  animation: statusPulse 1.8s ease-in-out infinite;
}

/* FOOTER */

.project-page-footer {
  width: min(1000px, calc(100% - 48px));
  margin: 0 auto;

  padding: 120px 0;

  border-top: 1px solid
    rgba(255,255,255,0.08);

  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;
}

.project-page-footer h2 {
  margin: 0;

  font-size: clamp(40px, 5vw, 68px);
  line-height: 0.95;
  letter-spacing: -0.04em;
}

.project-page-footer h2 span {
  display: block;
  color: #666;
}

/* 404 */

.project-not-found {
  min-height: 100vh;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;
  padding: 30px;
}

.project-not-found h1 {
  margin: 20px 0 40px;

  font-size: clamp(48px, 8vw, 100px);
  line-height: 0.9;
}

.project-not-found h1 span {
  display: block;
  color: #666;
}

/* ANIMATIONS */

@keyframes caseStudyCore {
  0%,
  100% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.05);
  }
}

@keyframes orbitOne {
  from {
    transform: rotate(25deg) rotate(0deg);
  }

  to {
    transform: rotate(25deg) rotate(360deg);
  }
}

@keyframes orbitTwo {
  from {
    transform: rotate(-30deg) rotate(360deg);
  }

  to {
    transform: rotate(-30deg) rotate(0deg);
  }
}

@keyframes statusPulse {
  0%,
  100% {
    opacity: 1;
  }

  50% {
    opacity: 0.35;
  }
}

/* MOBILE */

@media (max-width: 768px) {
  .project-page-nav {
    width: calc(100% - 32px);
    padding: 24px 0;
  }

  .project-hero {
    width: calc(100% - 32px);
    padding: 80px 0 50px;
  }

  .project-page-meta {
    flex-wrap: wrap;
    margin-bottom: 30px;
  }

  .project-hero h1 {
    font-size: clamp(54px, 16vw, 90px);
  }

  .project-page-description {
    font-size: 16px;
  }

  .case-study-visual {
    width: calc(100% - 32px);
    height: 400px;
    margin-bottom: 80px;
  }

  .case-study-core {
    width: 130px;
    height: 130px;
    font-size: 17px;
  }

  .case-study-floating {
    font-size: 8px;
    padding: 9px 11px;
  }

  .case-study-content {
    width: calc(100% - 32px);
  }

  .case-study-block {
    grid-template-columns: 1fr;
    gap: 25px;
    padding: 70px 0;
  }

  .case-study-copy h2 {
    font-size: clamp(42px, 13vw, 65px);
  }

  .architecture-grid {
    grid-template-columns: 1fr;
  }

  .project-page-footer {
    width: calc(100% - 32px);
    padding: 80px 0;
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 480px) {
  .back-link {
    font-size: 9px;
  }

  .project-hero h1 {
    font-size: 54px;
  }

  .project-page-actions {
    flex-direction: column;
    align-items: flex-start;
  }

  .case-study-visual {
    height: 330px;
  }

  .floating-one {
    left: 5%;
  }

  .floating-two {
    right: 5%;
  }

  .floating-three {
    left: 8%;
  }

  .status-display {
    flex-wrap: wrap;
  }

  .status-display > span:last-child {
    margin-left: 0;
  }
}